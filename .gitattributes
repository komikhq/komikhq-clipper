# === Export Ignore (excluded from `git archive` / GitHub source ZIP) ===
.gitattributes     export-ignore
.gitignore         export-ignore
.github/           export-ignore
.editorconfig      export-ignore
keys/              export-ignore
*.pem              export-ignore
README.md          export-ignore
LICENSE            export-ignore
docs/              export-ignore
scripts/           export-ignore

# === Binary files ===
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.crx binary
*.xpi binary
*.zip binary
