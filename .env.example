# ==========================================
# KomikHQ Clipper - Environment Variables
# ==========================================

# Google Gemini API Key (Used by .github/scripts/generate-release-notes)
GEMINI_API_KEY=your_gemini_api_key_here

# Extension Signing (Optional for local CRX3 build)
# EXTENSION_PEM_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ---- Publish to Web Stores (publish-stores.yml) ----

# Microsoft Edge Store Submission
# EDGE_PRODUCT_ID=
# EDGE_CLIENT_ID=
# EDGE_API_KEY=

# Mozilla Firefox AMO Submission
# AMO_EXTENSION_ID=
# AMO_JWT_ISSUER=
# AMO_JWT_SECRET=
